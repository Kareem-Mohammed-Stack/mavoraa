{%- comment -%}
  Orca Modern Navbar (Desktop)
  Exact Navigation Order: Home → Categories → All Products → Contact
  - Home: /
  - Categories: Categories SVG icon + Dropdown with collections
  - All Products: /collections/all
  - Contact: /pages/contact
{%- endcomment -%}

{%- liquid
  assign current_path = request.path

  assign is_home_active = false
  if current_path == '/' or template == 'index'
    assign is_home_active = true
  endif

  assign is_categories_active = false
  if current_path contains '/collections/' and current_path != '/collections/all'
    assign is_categories_active = true
  elsif template contains 'collection' and collection.handle != 'all'
    assign is_categories_active = true
  elsif current_path == routes.collections_url or current_path == '/collections' or template == 'list-collections'
    assign is_categories_active = true
  endif

  assign is_all_products_active = false
  if current_path == '/collections/all'
    assign is_all_products_active = true
  elsif template contains 'collection' and collection.handle == 'all'
    assign is_all_products_active = true
  endif

  assign is_contact_active = false
  if current_path contains '/pages/contact' or page.handle == 'contact'
    assign is_contact_active = true
  endif

  assign category_handles = 'health-wellness,beauty-personal-care,home-kitchen,smart-tech-gadgets,pet-essentials,baby-kids-toys' | split: ','
-%}

<nav class="header__inline-menu header__modern-nav" aria-label="{{ 'sections.header.menu' | t }}">
  <ul class="header__nav-list" role="list">
    <!-- 1. Home -->
    <li class="header__nav-item">
      <a
        href="{{ routes.root_url }}"
        class="header__nav-link{% if is_home_active %} is-active{% endif %}"
        {% if is_home_active %}aria-current="page"{% endif %}
      >
        <span class="header__nav-text">Home</span>
      </a>
    </li>

    <!-- 2. Categories (with SVG icon and Dropdown) -->
    <li class="header__nav-item header__menu-categories" id="HeaderCategoriesDropdown">
      <button
        type="button"
        class="header__nav-link header__nav-link--categories{% if is_categories_active %} is-active{% endif %}"
        aria-expanded="false"
        aria-haspopup="true"
        aria-controls="HeaderCategoriesMenu"
        id="HeaderCategoriesTrigger"
      >
        <!-- Categories 4-grid SVG Icon -->
        <svg class="header__cat-icon" width="16" height="16" viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
          <rect x="2.5" y="2.5" width="6" height="6" rx="1.5" stroke="currentColor" stroke-width="1.8"/>
          <rect x="11.5" y="2.5" width="6" height="6" rx="1.5" stroke="currentColor" stroke-width="1.8"/>
          <rect x="2.5" y="11.5" width="6" height="6" rx="1.5" stroke="currentColor" stroke-width="1.8"/>
          <rect x="11.5" y="11.5" width="6" height="6" rx="1.5" stroke="currentColor" stroke-width="1.8"/>
        </svg>
        <span class="header__nav-text">Categories</span>
        <!-- Dropdown Caret Icon -->
        <svg class="header__caret-icon" width="10" height="6" viewBox="0 0 10 6" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
          <path d="M1 1L5 5L9 1" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </button>

      <!-- Floating Dropdown Card -->
      <div class="header__dropdown-menu" id="HeaderCategoriesMenu" role="menu" aria-label="Categories">
        <div class="header__dropdown-header">
          <span class="header__dropdown-badge">
            <svg width="12" height="12" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2">
              <rect x="2.5" y="2.5" width="6" height="6" rx="1.5"/>
              <rect x="11.5" y="2.5" width="6" height="6" rx="1.5"/>
              <rect x="2.5" y="11.5" width="6" height="6" rx="1.5"/>
              <rect x="11.5" y="11.5" width="6" height="6" rx="1.5"/>
            </svg>
            Featured Categories
          </span>
          <a href="{{ routes.collections_url }}" class="header__dropdown-view-all">All Categories &rarr;</a>
        </div>
        <ul class="header__categories-grid" role="list">
          {%- for handle in category_handles -%}
            {%- assign cat = collections[handle] -%}
            {%- liquid
              assign cat_title = handle | replace: '-', ' ' | capitalize
              assign cat_url = '/collections/' | append: handle
              assign cat_count = ''
              assign cat_image = blank

              if cat != empty and cat != blank
                if cat.title != blank
                  assign cat_title = cat.title
                endif
                if cat.url != blank
                  assign cat_url = cat.url
                endif
                if cat.all_products_count != blank and cat.all_products_count > 0
                  assign cat_count = cat.all_products_count | append: ' products'
                endif
                if cat.image != blank
                  assign cat_image = cat.image
                elsif cat.featured_image != blank
                  assign cat_image = cat.featured_image
                endif
              endif

              case handle
                when 'health-wellness'
                  assign cat_title = 'Health & Wellness'
                  assign cat_fallback_img = 'shopify-col-wellness.jpg' | asset_url
                  if cat_url == blank or cat_url == ''
                    assign cat_url = '/collections/health-wellness'
                  endif
                when 'beauty-personal-care'
                  assign cat_title = 'Beauty & Personal Care'
                  assign cat_fallback_img = 'shopify-col-beauty.jpg' | asset_url
                  if cat_url == blank or cat_url == ''
                    assign cat_url = '/collections/beauty-personal-care'
                  endif
                when 'home-kitchen'
                  assign cat_title = 'Home & Kitchen'
                  assign cat_fallback_img = 'shopify-col-kitchen.jpg' | asset_url
                  if cat_url == blank or cat_url == ''
                    assign cat_url = '/collections/home-kitchen'
                  endif
                when 'smart-tech-gadgets'
                  assign cat_title = 'Smart Tech & Gadgets'
                  assign cat_fallback_img = 'shopify-col-tech.jpg' | asset_url
                  if cat_url == blank or cat_url == ''
                    assign cat_url = '/collections/smart-tech-gadgets'
                  endif
                when 'pet-essentials'
                  assign cat_title = 'Pet Essentials'
                  assign cat_fallback_img = 'shopify-col-pet.jpg' | asset_url
                  if cat_url == blank or cat_url == ''
                    assign cat_url = '/collections/pet-essentials'
                  endif
                when 'baby-kids-toys'
                  assign cat_title = 'Baby, Kids & Toys'
                  assign cat_fallback_img = 'shopify-col-baby.jpg' | asset_url
                  if cat_url == blank or cat_url == ''
                    assign cat_url = '/collections/baby-kids-toys'
                  endif
              endcase

              if cat_url == blank or cat_url == ''
                assign cat_url = '/collections/' | append: handle
              endif

              assign is_item_active = false
              if current_path == cat_url
                assign is_item_active = true
              endif
            -%}
            <li role="none">
              <a
                href="{{ cat_url }}"
                role="menuitem"
                class="header__category-card{% if is_item_active %} is-active{% endif %}"
              >
                <div class="header__category-thumb">
                  {%- if cat_image != blank -%}
                    <img
                      src="{{ cat_image | image_url: width: 80, height: 80, crop: 'center' }}"
                      alt="{{ cat_title | escape }}"
                      width="38"
                      height="38"
                      loading="lazy"
                    >
                  {%- elsif cat_fallback_img != blank -%}
                    <img
                      src="{{ cat_fallback_img }}"
                      alt="{{ cat_title | escape }}"
                      width="38"
                      height="38"
                      loading="lazy"
                    >
                  {%- else -%}
                    <span class="header__category-fallback-icon">
                      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
                        <path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"/>
                        <polyline points="3.27 6.96 12 12.01 20.73 6.96"/>
                        <line x1="12" y1="22.08" x2="12" y2="12"/>
                      </svg>
                    </span>
                  {%- endif -%}
                </div>
                <div class="header__category-info">
                  <span class="header__category-name">{{ cat_title }}</span>
                  {%- if cat_count != blank -%}
                    <span class="header__category-count">{{ cat_count }}</span>
                  {%- endif -%}
                </div>
                <svg class="header__category-arrow" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <path d="M9 18l6-6-6-6"/>
                </svg>
              </a>
            </li>
          {%- endfor -%}
        </ul>
        <div class="header__dropdown-footer">
          <a href="{{ routes.collections_url }}" class="header__dropdown-footer-btn" style="margin-bottom: 6px;">
            <span>Explore All Categories</span>
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M5 12h14M12 5l7 7-7 7"/>
            </svg>
          </a>
          <a href="{{ routes.all_products_collection_url }}" class="header__dropdown-footer-btn">
            <span>Explore All Products</span>
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M5 12h14M12 5l7 7-7 7"/>
            </svg>
          </a>
        </div>
      </div>
    </li>

    <!-- 3. All Products -->
    <li class="header__nav-item">
      <a
        href="{{ routes.all_products_collection_url }}"
        class="header__nav-link{% if is_all_products_active %} is-active{% endif %}"
        {% if is_all_products_active %}aria-current="page"{% endif %}
      >
        <span class="header__nav-text">All Products</span>
      </a>
    </li>

    <!-- 4. Contact -->
    <li class="header__nav-item">
      <a
        href="/pages/contact"
        class="header__nav-link{% if is_contact_active %} is-active{% endif %}"
        {% if is_contact_active %}aria-current="page"{% endif %}
      >
        <span class="header__nav-text">Contact</span>
      </a>
    </li>
  </ul>
</nav>

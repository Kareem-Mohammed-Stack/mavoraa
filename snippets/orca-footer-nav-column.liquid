{%- liquid
  assign column = column | default: 'shop'
-%}

<ul class="orca-foot__links" role="list">
  {%- if column == 'shop' -%}
    <li>
      <a href="{{ routes.root_url }}" class="orca-foot__link{% if request.page_type == 'index' %} is-active{% endif %}">
        Home
      </a>
    </li>
    <li>
      <a
        href="{{ routes.all_products_collection_url }}"
        class="orca-foot__link{% if request.page_type == 'collection' and collection.handle == 'all' %} is-active{% endif %}"
      >
        Shop
      </a>
    </li>
    {%- liquid
      assign contact_page = pages.contact
      assign contact_url = contact_page.url | default: '/pages/contact'
    -%}
    <li>
      <a href="{{ contact_url }}" class="orca-foot__link{% if request.page_type == 'page' and page.handle == 'contact' %} is-active{% endif %}">
        Contact
      </a>
    </li>
  {%- elsif column == 'information' -%}
    {%- liquid
      assign privacy_url = shop.privacy_policy.url | default: routes.privacy_policy_url | default: '/policies/privacy-policy'
      assign refund_url = shop.refund_policy.url | default: routes.refund_policy_url | default: '/policies/refund-policy'
      assign terms_url = shop.terms_of_service.url | default: routes.terms_of_service_url | default: '/policies/terms-of-service'
      assign shipping_url = shop.shipping_policy.url | default: routes.shipping_policy_url | default: '/policies/shipping-policy'
      assign about_page = pages['about-us']
      assign about_url = about_page.url | default: '/pages/about-us'
    -%}
    <li>
      <a href="{{ privacy_url }}" class="orca-foot__link">Privacy Policy</a>
    </li>
    <li>
      <a href="{{ refund_url }}" class="orca-foot__link">Refund Policy</a>
    </li>
    <li>
      <a href="{{ terms_url }}" class="orca-foot__link">Terms of Service</a>
    </li>
    <li>
      <a href="{{ shipping_url }}" class="orca-foot__link">Shipping Policy</a>
    </li>
    <li>
      <a href="{{ about_url }}" class="orca-foot__link{% if request.page_type == 'page' and page.handle == 'about-us' %} is-active{% endif %}">About Us</a>
    </li>
  {%- endif -%}
</ul>
